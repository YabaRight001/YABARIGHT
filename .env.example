# Database Connection (Required for Vercel and production persistence)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Get a free database instantly from Neon (https://neon.tech), Supabase (https://supabase.com), or Vercel Postgres Storage.
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Auth
JWT_SECRET="yabaright-jwt-secret-key-replace-in-production"

# Site URL
NEXT_PUBLIC_SITE_URL="https://yabaright-app.vercel.app"
